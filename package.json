{
	"name": "@nedcloarbr/nestjs-toolkit",
	"version": "1.3.4",
	"description": "A collection of tools and utilities for NestJS applications.",
	"author": "NedcloarBR",
	"license": "MIT",
	"homepage": "https://github.com/NedcloarBR/nestjs-tools#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NedcloarBR/nestjs-tools.git"
	},
	"bugs": {
		"url": "https://github.com/NedcloarBR/nestjs-tools/issues"
	},
	"keywords": [
		"nestjs",
		"toolkit",
		"cli",
		"helpers",
		"utilities",
		"nest-commander",
		"typescript",
		"node",
		"tools",
		"configuration",
		"key-generation",
		"async",
		"date",
		"security",
		"string"
	],
	"bin": "./dist/src/main.js",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"default": "./dist/src/index.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/src/index.js",
	"types": "./dist/src/index.d.ts",
	"files": [
		"dist",
		"typings",
		"README.md",
		"LICENSE.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"generate:helpers": "node --import @swc-node/register/esm-register ./scripts/generate-typings.ts",
		"build": "yarn clean && yarn generate:helpers && tsc -p tsconfig.build.json && yarn postbuild",
		"postbuild": "node --import @swc-node/register/esm-register ./scripts/postbuild.ts",
		"start": "node --import @swc-node/register/esm-register ./src/main.ts",
		"start:dev": "node --import @swc-node/register/esm-register --watch ./src/main.ts",
		"start:debug": "node --import @swc-node/register/esm-register --inspect ./src/main.ts",
		"start:prod": "node ./dist/src/main.js",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"biome:format": "yarn biome format --write ./",
		"biome:lint": "yarn biome lint ./",
		"biome:check": "yarn biome check --write ./",
		"test:command": "yarn build && node ./dist/src/main.js",
		"release": "yarn release-it",
		"changelog": "git cliff --prepend ./CHANGELOG.md -l --current -c ./cliff.toml -r ."
	},
	"packageManager": "yarn@4.9.3",
	"engines": {
		"node": ">=20.19.0"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"peerDependencies": {
		"@nestjs/common": "^11.0.0 || ^12.0.0",
		"@nestjs/core": "^11.0.0 || ^12.0.0",
		"reflect-metadata": "^0.1.0 || ^0.2.0",
		"rxjs": "^7.1.0"
	},
	"dependencies": {
		"chalk": "^5.6.2",
		"nest-commander": "^3.21.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.2",
		"@nedcloarbr/biome-config": "^2.0.1",
		"@nestjs/common": "^12.0.1",
		"@nestjs/core": "^12.0.1",
		"@swc-node/register": "^1.12.1",
		"@swc/core": "^1.16.2",
		"@types/inquirer": "^9.0.9",
		"@types/node": "^22.18.8",
		"reflect-metadata": "^0.2.2",
		"release-it": "^19.0.5",
		"rxjs": "^7.8.2",
		"ts-morph": "^28.0.0",
		"typescript": "^6.0.3"
	}
}
